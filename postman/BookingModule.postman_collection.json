{
  "info": {
    "name": "Booking Module",
    "description": "Campus Ops — booking API flow (login → CRUD → admin actions).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "resourceId", "value": "1" },
    { "key": "bookingId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.token) {",
              "  pm.collectionVariables.set(\"token\", json.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "2. Create Booking",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resourceId\": {{resourceId}},\n  \"startTime\": \"2026-06-01T09:00:00\",\n  \"endTime\": \"2026-06-01T11:00:00\",\n  \"purpose\": \"Team Meeting\",\n  \"attendees\": 10\n}"
        },
        "url": "{{baseUrl}}/api/bookings"
      }
    },
    {
      "name": "3. Create Conflicting Booking (expect 409)",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"resourceId\": {{resourceId}},\n  \"startTime\": \"2026-06-01T09:00:00\",\n  \"endTime\": \"2026-06-01T11:00:00\",\n  \"purpose\": \"Overlap test\",\n  \"attendees\": 5\n}"
        },
        "url": "{{baseUrl}}/api/bookings"
      }
    },
    {
      "name": "4. Get My Bookings",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/my"
      }
    },
    {
      "name": "5. Get Booking By ID",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
      }
    },
    {
      "name": "6. Get Resource Availability",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/resource/{{resourceId}}/availability"
      }
    },
    {
      "name": "7. Get All Bookings (Admin)",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings?status=PENDING"
      }
    },
    {
      "name": "8. Approve Booking (Admin)",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/approve"
      }
    },
    {
      "name": "9. Reject Booking with Reason (Admin)",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/reject?reason=Clash+with+exam"
      }
    },
    {
      "name": "10. Cancel Booking",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel"
      }
    }
  ]
}
